#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/mouse.h>

// OS設定を日本語キーボードのまま使用するための変換定義
#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角

&mt {
    tapping-term-ms = <300>;
    flavor = "balanced";
};

&lt {
    quick-tap-ms = <300>;
};

&zip_temp_layer {
    require-prior-idle-ms = <200>;
    excluded-positions = <7 16 17 18>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_hanzen {
            timeout-ms = <50>;
            key-positions = <0 34>;
            bindings = <&lt 1 JP_HANZEN>;
        };
    };
    
    macros {
        emoji: emoji_macro {
            compatible = "zmk,behavior-macro";
            label = "EMOJI";
            #binding-cells = <0>;
            bindings = 
                <&macro_press &kp CAPSLOCK>,
                <&macro_tap &kp E>,
                <&macro_release &kp CAPSLOCK>;
        };
    };

    behaviors {
        encoder_msc: sensor_rotate_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            tap-ms = <20>;
        };

        encoder_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };
    };





    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
                &kp Q             &kp W            &kp E             &kp R          &kp T                                        &kp Y            &kp U           &kp I          &kp O           &kp P
                &kp A             &kp S            &kp D             &kp F          &kp G                                        &kp H            &kp J           &kp K          &kp L           &mt RCTRL MINUS
                &mt LEFT_SHIFT Z  &kp X            &kp C             &kp V          &kp B                                        &kp N            &kp M           &kp COMMA      &kp DOT         &mt RIGHT_SHIFT SLASH
                &kp LEFT_ALT      &none            &kp LEFT_WIN      &msc SCRL_UP   &lt 2 SPACE   &lt 6 INT_MUHENKAN             &kp BACKSPACE    &kp ENTER       &msc SCRL_UP   &none           &none                   &tog 5
                                                   &msc SCRL_LEFT     &msc SCRL_DOWN  &msc SCRL_RIGHT                              &msc SCRL_LEFT   &msc SCRL_DOWN  &msc SCRL_RIGHT
            >;
            sensor-bindings = <&encoder_msc SCRL_UP SCRL_DOWN>;
        };

        layer_1 {
            display-name = "Function Layer";
            bindings = <
                &kp F1                 &kp F2          &kp F3          &kp F4        &kp F5                             &kp F6    &kp F7                 &kp F8        &kp F9        &kp F10
                &mt LCTRL PRINTSCREEN  &kp LC(N)       &kp LC(LS(N))   &kp LA(F4)    &kp LG(R)                          &kp F11   &kp LC(LS(SEMICOLON))  &kp RA(ENTER)  &kp RC(MINUS)  &kp F12
                &kp LEFT_SHIFT         &kp LC(LA(X))   &kp LA(LC(C))   &kp LC(LA(V)) &trans                             &trans    &trans                 &trans         &trans         &kp RIGHT_SHIFT
                &trans                 &trans          &trans          &msc SCRL_UP  &trans            &trans           &trans    &trans                 &msc SCRL_UP   &none          &none              &none
                                                       &msc SCRL_LEFT  &msc SCRL_DOWN &msc SCRL_RIGHT                   &msc SCRL_LEFT &msc SCRL_DOWN  &msc SCRL_RIGHT
            >;
            sensor-bindings = <&encoder_msc SCRL_UP SCRL_DOWN>;
        };

        layer_2 {
            display-name = "Number Layer";
            bindings = <
                &kp NUMBER_1    &kp NUMBER_2       &kp NUMBER_3      &kp NUMBER_4    &kp N5                                      &kp NUMBER_6    &kp N7          &kp N8          &kp N9           &kp N0
                &mt LCTRL TAB   &kp JP_YEN         &kp JP_AT         &kp JP_CARET    &kp LEFT_ALT                                &kp HOME        &mkp MB1        &kp UP_ARROW    &mkp MB2         &mt RCTRL JP_COLON
                &kp LEFT_SHIFT  &kp JP_UNDERSCORE  &kp JP_LBRACKET   &kp JP_RBRACKET &none                                       &kp END         &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW &mt RIGHT_SHIFT SEMICOLON
                &trans          &trans             &trans            &msc SCRL_UP    &trans                &trans               &kp DELETE      &kp ESCAPE      &msc SCRL_UP    &none             &none                    &none
                                                   &msc SCRL_LEFT     &msc SCRL_DOWN  &msc SCRL_RIGHT                              &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT
            >;
            sensor-bindings = <&encoder_msc SCRL_UP SCRL_DOWN>;
        };

        layer_3 {
            display-name = "Brank Layer";
            bindings = <
                &trans  &trans  &trans  &trans  &trans                     &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans                     &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans                     &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans             &trans  &trans  &trans  &trans  &trans  &trans
                                &trans  &trans  &trans                     &trans  &trans  &trans
            >;
        };

        layer_4 {
            display-name = "Device Layer";
            bindings = <
                &none        &none           &none  &none  &bt BT_CLR                       &bt BT_SEL 0   &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
                &none        &none           &none  &none  &none                            &none          &none         &none         &none         &none
                &sys_reset   &none           &none  &none  &none                            &none          &none         &none         &none         &sys_reset
                &bootloader  &bt BT_CLR_ALL  &none  &none  &none  &none                    &studio_unlock &none         &none         &none         &none         &bootloader
                                             &trans &trans &trans                           &trans         &trans        &trans
            >;
        };

        layer_5 {
            display-name = "Mouse Layer";
            bindings = <
                &trans  &trans  &trans  &trans  &trans                     &trans  &trans    &mkp MB3  &trans    &trans
                &trans  &trans  &trans  &trans  &trans                     &trans  &mkp MB1  &mo 6     &mkp MB2  &trans
                &trans  &trans  &trans  &trans  &trans                     &trans  &trans    &trans    &trans    &trans
                &trans  &trans  &trans  &trans  &trans  &trans             &trans  &trans    &trans    &trans    &trans  &trans
                                &trans  &trans  &trans                     &trans  &trans    &trans
            >;
        };

        layer_6 {
            display-name = "Scroll Layer";
            bindings = <
                &trans  &trans  &trans  &trans  &trans                     &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans                     &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans                     &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans             &trans  &trans  &trans  &trans  &trans  &trans
                                &trans  &trans  &trans                     &trans  &trans  &trans
            >;
        };

        layer_7 {
            status = "reserved";
            display-name = "Brank Layer";
            bindings = <
                &trans  &trans  &trans  &trans  &trans                     &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans                     &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans                     &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans             &trans  &trans  &trans  &trans  &trans  &trans
                                &trans  &trans  &trans                     &trans  &trans  &trans
            >;
        };
    };
};
